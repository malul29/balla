# ── Wajib ──────────────────────────────────────────────
# Domain yang sudah diarahkan (DNS A record) ke IP VPS. Contoh: dokumen.sultanaliving.co.id
DOMAIN=dokumen.contoh.co.id

# Password database. Pakai huruf/angka saja. Buat dengan:  openssl rand -hex 24
DB_PASSWORD=ganti-dengan-password-acak

# Akun admin pertama. Hanya dipakai saat database masih kosong. Ganti password setelah login pertama.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti-password-admin-min-8
ADMIN_NAME=Administrator

# ── Opsional ───────────────────────────────────────────
# Lama sesi login (hari)
SESSION_DAYS=7
# Zona waktu untuk nomor surat & tanggal
APP_TIMEZONE=Asia/Jakarta
# Hanya untuk uji coba lewat IP tanpa HTTPS (JANGAN dipakai di produksi):
# COOKIE_SECURE=false
